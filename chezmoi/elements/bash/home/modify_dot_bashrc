#!/bin/sh
# 標準入力で受け取った ~/.bashrc へ、dotfiles.bashrc を読み込む記述を加えて標準出力へ書き出す。
# 記述が既にある場合は入力をそのまま書き出す。入力の内容は変更しない。

set -eu

# 読み込みの記述に固有の文字列を固定文字列として検索し、追記済みかどうかを判定する。
marker='.config/bash/dotfiles.bashrc'

# 入力をファイルへ受ける。コマンド置換は末尾の改行を落とすため、入力をそのまま書き出せない
input=$(mktemp)
trap 'rm -f "$input"' EXIT
cat >"$input"

# 入力を先に復元し、必要な場合だけ末尾へ読み込みの記述を追加する。
cat "$input"

if grep -qF "$marker" "$input"; then
    exit 0
fi

if [ -s "$input" ]; then
    # 末尾が改行で終わらない場合に改行を補い、既存の内容との間を 1 行空ける
    [ "$(tail -c 1 "$input" | wc -l)" -eq 1 ] || printf '\n'
    printf '\n'
fi

# 対象ファイルが存在する場合だけ読み込み、未配置の環境でもシェルの起動を妨げない。
cat <<'LOADER'
# dotfiles (chezmoi) managed settings
[ -f ~/.config/bash/dotfiles.bashrc ] && . ~/.config/bash/dotfiles.bashrc
LOADER

{{- /* WSL 上の Linux と、それ以外の Linux を区別する。カーネルの osrelease に microsoft を含むかで判定する。 */ -}}
{{- $isWSL := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   $isWSL = contains "microsoft" (lower .chezmoi.kernel.osrelease) -}}
{{- end -}}
{{- /* modify_ スクリプトの実行に用いる PowerShell。JSON 中のコメントと非 ASCII 文字を素直に扱えるため pwsh を優先する。 */ -}}
{{- $powershell := "powershell" -}}
{{- if lookPath "pwsh" -}}
{{-   $powershell = "pwsh" -}}
{{- end -}}

[data]
    isWSL = {{ $isWSL }}
{{ if eq .chezmoi.os "windows" -}}
[interpreters.ps1]
    command = {{ $powershell | quote }}
    args = ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File"]
{{ end -}}
